<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build config for Java reactors.

  - Source: java/src/        (reactor and utility classes)
  - Output: classes/         (compiled .class files, loaded by SEMOSS at runtime)
  - SEMOSS JAR is "provided"  (it's on the server classpath, not bundled)

  Build with: mvn clean compile (or use the SEMOSS UI build button)
--><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>SemossTemplate</groupId>
  <artifactId>SemossTemplate</artifactId>
  <version>${ci.version}</version>
  <!-- Version property used by both this project and the SEMOSS dependency -->
  <properties>
    <ci.version>0.0.1-SNAPSHOT</ci.version>
  </properties>
  <build>
    <!-- Main source lives in java/src/ instead of the Maven default src/main/java -->
    <sourceDirectory>java/src</sourceDirectory>
    <!-- Test source lives in test/ instead of the Maven default src/test/java -->
    <testSourceDirectory>test</testSourceDirectory>
    <!-- Compiled classes go to classes/ so SEMOSS can load them at runtime -->
    <outputDirectory>classes</outputDirectory>
    <!-- Compiled test classes go to test-classes/ -->
    <testOutputDirectory>test-classes</testOutputDirectory>
    <!-- Include non-Java files from java/ (e.g. project.properties) as classpath resources -->
    <resources>
      <resource>
        <directory>java</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
    <!-- Test resources (e.g. log4j2-test.xml) live in test/resources/ -->
    <testResources>
      <testResource>
        <directory>test/resources</directory>
      </testResource>
    </testResources>
    <!-- Compile with Java 21 source/target -->
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!-- Maven repositories: Central and SEMOSS Nexus -->
  <repositories>
    <!-- Maven Central — primary public repository -->
    <repository>
      <id>central</id>
      <name>Maven Repository Switchboard</name>
      <layout>default</layout>
      <url>https://repo1.maven.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <!-- SEMOSS Nexus — hosts the semoss artifact and other internal JARs -->
    <repository>
      <id>3rdPartyJARs</id>
      <name>Maven repository</name>
      <url>https://maven.semoss.org/repository/3rdPartyJARs</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>
  <dependencies>
    <!-- SEMOSS core — provided by the server at runtime, not bundled into output -->
    <dependency>
      <groupId>org.semoss</groupId>
      <artifactId>semoss</artifactId>
      <version>${ci.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- ===== Test dependencies (only used during mvn test, not shipped) ===== -->
    <!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api
         JUnit Jupiter — test framework for writing and running tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>
    <!-- https://mvnrepository.com/artifact/org.junit.platform/junit-platform-suite
         JUnit Platform Suite — allows grouping tests into suites (see ReactorTestSuite) -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>6.0.0</version>
      <scope>test</scope>
    </dependency>
    <!-- https://mvnrepository.com/artifact/org.mockito/mockito-core
         Mockito — mocking framework for isolating reactor logic in tests.
         byte-buddy and objenesis are excluded because SEMOSS already provides them. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>net.bytebuddy</groupId>
          <artifactId>byte-buddy</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.objenesis</groupId>
          <artifactId>objenesis</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>