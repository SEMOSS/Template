# SEMOSS credentials — one access/secret pair per environment.
# Copy this file to semoss_config/credentials.env and fill in your keys.
# Never commit credentials.env — it is gitignored.
#
# The prefix must match the environment name in environments.json, uppercased.
# Example: an env named "local" uses LOCAL_ACCESS_KEY / LOCAL_SECRET_KEY.
#          an env named "prod"  uses PROD_ACCESS_KEY / PROD_SECRET_KEY.

# LOCAL_ACCESS_KEY=
# LOCAL_SECRET_KEY=

# PREPROD_ACCESS_KEY=
# PREPROD_SECRET_KEY=

# PROD_ACCESS_KEY=
# PROD_SECRET_KEY=
